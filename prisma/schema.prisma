// CivicChain — Phase 1 database schema
// PostgreSQL + PostGIS + Prisma ORM (v7, prisma-client generator).
//
// Conventions:
//   - IDs: cuid() strings (server-generated, never client-supplied).
//   - Coordinates: latitude/longitude stored as nullable Double columns.
//     A PostGIS geography(Point,4326) column is added by raw SQL in the
//     initial migration (see prisma/migrations/.../migration.sql — "PostGIS").
//   - Sensitive identity is always derived from the authenticated session;
//     no browser-supplied userId/role is ever trusted.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs now live in prisma.config.ts (Prisma 7).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CITIZEN
  AUTHORITY
  ADMIN
}

// Gate for role requests made during self-service signup. Signup never grants
// a privileged role directly; an existing ADMIN must approve the request.
enum RoleApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum IssueCategory {
  POTHOLE
  DRAINAGE
  STREETLIGHT
  GARBAGE
  INFRASTRUCTURE
  WATER
  OTHER
}

// Authoritative lifecycle. Display statuses shown in the UI are derived
// server-side (see src/lib/issues/status.ts).
enum IssueStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  IMAGE
  VIDEO
  URL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PromiseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  BROKEN
}

enum AuditAction {
  REPORT_CREATED
  REPORT_UPDATED
  STATUS_CHANGED
  EVIDENCE_ADDED
  VERIFICATION_CREATED
  ESCALATION_CREATED
  AUTHORITY_ASSIGNED
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
  INCIDENT_ASSIGNED
  ROLE_REQUEST_APPROVED
  ROLE_REQUEST_REJECTED
}

enum NotificationType {
  REPORT_CREATED
  STATUS_CHANGED
  EVIDENCE_ADDED
  VERIFICATION_CREATED
  ESCALATION_CREATED
  AUTHORITY_ASSIGNED
  PROMISE_DEADLINE
  GENERAL
}

/** Delivery channel a Notification can be routed through (Phase 13). */
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

// ---------------------------------------------------------------------------
// Phase 3 — Real AI intelligence
// ---------------------------------------------------------------------------

/** Categories the AI model is asked to classify a report into. */
enum AICategory {
  ROAD_DAMAGE
  STREET_LIGHT
  GARBAGE
  WATER_LEAKAGE
  DRAINAGE
  TRAFFIC_SIGNAL
  PUBLIC_INFRASTRUCTURE
  OTHER
}

/** Severity vocabulary produced by the AI model (mirrors Severity values). */
enum AISeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/** Immediate safety risk to the public assessed by the AI model. */
enum SafetyRisk {
  NONE
  LOW
  MODERATE
  HIGH
  CRITICAL
}

/** The class of civic asset the AI model believes is damaged/affected. */
enum InfrastructureType {
  ROAD
  SIDEWALK
  BRIDGE
  STREET_LIGHT
  TRAFFIC_SIGNAL
  DRAINAGE_SYSTEM
  WATER_SUPPLY
  PUBLIC_BUILDING
  PARK
  NONE
  OTHER
}

/** Lifecycle of a server-side AI analysis run. No duration is simulated. */
enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Phase 4 — Priority levels
// ---------------------------------------------------------------------------

/** Band derived from the 0-100 priority engine score. */
enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ---------------------------------------------------------------------------
// Phase 7 — Automated escalation
// ---------------------------------------------------------------------------

/**
 * Canonical escalation levels. The department escalation ladder. Kept as a
 * shared constant so levels are never arbitrary strings scattered in code;
 * the DB persists the numeric `level` (1-4) on the Escalation model.
 */
enum EscalationLevel {
  LEVEL_1 // Department Officer
  LEVEL_2 // Department Head
  LEVEL_3 // Municipal Authority
  LEVEL_4 // Admin
}

// ---------------------------------------------------------------------------
// Phase 10 — Community voting & civic karma
// ---------------------------------------------------------------------------

enum VoteType {
  CONFIRM
  DISPUTE
  SUPPORT
  DUPLICATE
}

enum KarmaEventType {
  REPORT_VERIFIED
  EVIDENCE_VERIFIED
  HELPFUL_CONFIRMATION
  VALID_DUPLICATE
  FALSE_REPORT
  ABUSIVE_VOTE
}

// ---------------------------------------------------------------------------
// Identity & auth (NextAuth/Auth.js v5 + Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CITIZEN)
  // Privileged role requested at self-service signup (AUTHORITY/ADMIN).
  // Never trusted until an ADMIN approves it — see RoleApprovalStatus.
  requestedRole UserRole?
  roleStatus    RoleApprovalStatus @default(APPROVED)
  roleReviewedById String?
  roleReviewedAt   DateTime?

  roleReviewedBy User? @relation("RoleReviewer", fields: [roleReviewedById], references: [id], onDelete: SetNull)
  roleReviewees  User[] @relation("RoleReviewer")
  karmaScore    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  issues         Issue[]         @relation("IssueReporter")
  evidence       Evidence[]      @relation("EvidenceUploader")
  verifications  Verification[]  @relation("VerificationVerifier")
  escalations    Escalation[]    @relation("EscalationInitiator")
  authorities    Authority[]     @relation("AuthorityUser")
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
  preferences UserPreferences?
  auditLogs      AuditLog[]      @relation("AuditActor")
  votes          Vote[]
  karmaEvents    KarmaEvent[]
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  @@index([email])
  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ---------------------------------------------------------------------------
// Civic domain
// ---------------------------------------------------------------------------

model Authority {
  id          String   @id @default(cuid())
  name        String
  department  String
  email       String?
  phone       String?
  jurisdiction String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional link to the user account that acts as this authority's
  // operator (role AUTHORITY). Nullable so multiple departments can exist
  // without requiring an operator account.
  userId String? @unique
  user   User?   @relation("AuthorityUser", fields: [userId], references: [id], onDelete: SetNull)

  issues      Issue[]
  promises    Promise[]
  escalations Escalation[]

  @@index([department])
}

model Issue {
  id          String        @id @default(cuid())
  publicId    String        @unique // human-facing reference, e.g. CC-1092
  title       String
  description String?
  category    IssueCategory
  status      IssueStatus   @default(SUBMITTED)
  severity    Severity?
  priority    Int? // 0-100; null until a real scoring pipeline exists
  latitude    Float? // stored for PostGIS
  longitude   Float? // stored for PostGIS
  accuracy    Float? // GPS accuracy in metres; null when not captured
  location    String? // free-text address / landmark / ward
  contact     String? // reporter follow-up contact (confidential)
  reporterId  String
  authorityId String?

  // Phase 4 — duplicate engine + priority engine outputs.
  incidentId    String?
  incidentMatch Json?  // { incidentId, confidence, band, signals } audit trail
  priorityLevel PriorityLevel?

  // PostGIS point; created as a GENERATED ALWAYS AS ... geography column by
  // raw SQL in the initial migration. Unsupported() keeps Prisma aware of the
  // column so migrate diff does not try to drop it. GIST index also raw SQL.
  geoLocation Unsupported("geography(Point,4326)")?

  reporter  User?      @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  authority Authority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  evidence     Evidence[]
  verifications Verification[]
  escalations  Escalation[]
  auditLogs    AuditLog[]
  notifications Notification[]
  votes        Vote[]
  karmaEvents  KarmaEvent[]
  promise      Promise?
  aiAnalysis   AIAnalysis?
  incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([authorityId])
  @@index([incidentId])
  @@index([latitude, longitude])
  @@index([priority])
  @@index([priorityLevel])
  @@index([geoLocation], type: Gist, map: "issue_geoLocation_idx")
}

model Evidence {
  id           String       @id @default(cuid())
  issueId      String
  type         EvidenceType
  url          String // stored file reference (dev: /uploads/...; later: object storage)
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  metadata     Json?
  uploadedById String?
  // Phase 4 — perceptual image fingerprint computed server-side (dHash hex).
  // Populated for IMAGE evidence; used unchanged by the duplicate engine.
  perceptualHash String?

  issue   Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User? @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  verifications Verification[]

  createdAt DateTime @default(now())

  @@index([issueId])
  @@index([uploadedById])
}

model Promise {
  id          String        @id @default(cuid())
  issueId     String        @unique
  authorityId String?
  deadline    DateTime
  status      PromiseStatus @default(OPEN)
  description String?

  issue     Issue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authority Authority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorityId])
  @@index([status])
  @@index([deadline])
}

model Verification {
  id          String             @id @default(cuid())
  issueId     String
  verifierId  String?
  evidenceId  String?
  status      VerificationStatus @default(PENDING)
  note        String?

  issue    Issue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  verifier User?      @relation("VerificationVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  evidence Evidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([verifierId])
  @@index([evidenceId])
}

model Escalation {
  id          String           @id @default(cuid())
  issueId     String
  callerId    String?
  authorityId String?
  level       Int              @default(1)
  status      EscalationStatus @default(OPEN)
  reason      String?

  issue     Issue?     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  caller    User?      @relation("EscalationInitiator", fields: [callerId], references: [id], onDelete: SetNull)
  authority Authority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([status])
  @@index([level])
}

// ---------------------------------------------------------------------------
// Observability & messaging
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  issueId    String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  // Phase 18 — append-only tamper-evident hash chain (Audit/Trust Ledger).
  // `seq` is the monotonic chain position, `prevHash` links to the previous
  // record's `hash` (null only for the genesis record), and `hash` is the
  // SHA-256 fingerprint of this record's canonical payload chained onto
  // `prevHash`. A unique `prevHash` means two records can never claim the same
  // predecessor — a concurrent fork is rejected instead of silently accepted.
  seq      Int
  prevHash String?
  hash     String

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([seq])
  @@unique([prevHash])
  @@index([actorId])
  @@index([issueId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  issueId   String?
  type      NotificationType
  title     String
  message   String?
  read      Boolean          @default(false)
  /**
   * Deep-link the notification resolves to (e.g. /dashboard/issues/:id, or
   * /dashboard/settings when the action is preference-related). Null → no action.
   */
  link      String?
  /**
   * Idempotency guard (Phase 13). When provided, retried/duplicate events can
   * never persist a second notification for the same logical occurrence. e.g.
   * "STATUS_CHANGED:issue=<id>:to=RESOLVED".
   */
  dedupeKey String?          @unique
  /**
   * The channel that produced this persisted row. IN_APP rows are always
   * persisted here; EMAIL/PUSH rows are the delivery record for those channels.
   */
  channel   NotificationChannel @default(IN_APP)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, read, createdAt])
  @@index([issueId])
}

/**
 * Per-user opt-in/opt-out for each delivery channel (Phase 13). A user with no
 * row defaults to subscribing to a channel. Each (userId, channel) is unique so
 * a user holds at most one preference per channel. Lookup is never trusted from
 * the browser — it is keyed off the authoritative session user id.
 */
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Internals
// ---------------------------------------------------------------------------

// Single-row counter used to mint sequential, human-facing public IDs
// (CC-xxxx). Updated atomically inside the report-creation transaction.
model RefCounter {
  id    Int @id
  value Int @default(1090)
}

// ---------------------------------------------------------------------------
// Phase 3+4 — AI analysis, incidents & prioritization
// ---------------------------------------------------------------------------

/**
 * One server-side AI analysis run for a report. Real model inference only —
 * never fabricated. Lifecycle: PENDING -> PROCESSING -> COMPLETED | FAILED.
 * A FAILED run always leaves the parent Issue untouched and usable.
 */
model AIAnalysis {
  id         String            @id @default(cuid())
  issueId    String            @unique
  status     AIAnalysisStatus  @default(PENDING)
  category   AICategory?
  severity   AISeverity?
  confidence Float? // 0-1 model confidence in the classification
  safetyRisk SafetyRisk?
  infrastructureType InfrastructureType?
  reasoningSummary String?
  modelName         String?
  modelVersion      String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/**
 * A parent entity grouping individual citizen reports (Issue) that the
 * duplicate engine determined to describe the same underlying problem.
 * Individual reports remain independent and are never auto-deleted or blocked.
 */
model Incident {
  id        String        @id @default(cuid())
  publicId  String        @unique // human-facing reference, e.g. CC-INC-4
  title     String // derived from the first report in the cluster
  category  IssueCategory // current best category for the cluster
  status    IssueStatus   @default(SUBMITTED)
  severity  Severity?
  priority  Int?
  priorityLevel PriorityLevel?

  issues Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([priorityLevel])
}

// ---------------------------------------------------------------------------
// Phase 7 — Escalation rules (automated, configurable escalation ladder)
// ---------------------------------------------------------------------------

/**
 * A declarative, configurable rule that decides when an active Issue should be
 * escalated. Evaluated by the escalation engine (src/lib/escalation/engine).
 * Rules are data, not logic scattered in route handlers. `conditions` is a
 * JSON bag of numeric/enum gates, e.g. { "slaPctGte": 80, "statusNotIn": ["RESOLVED","REJECTED"] }.
 */
model EscalationRule {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(true)
  priority    Int      @default(0) // lower number evaluated first
  fromLevel   Int      @default(0) // minimum current escalation level required to trigger (0 = any)
  targetLevel Int      @default(1) // the ladder step this rule escalates TO
  minSeverity Severity?
  minPriority Int? // optional 0-100 priority gate
  conditions  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
}

// ---------------------------------------------------------------------------
// Phase 14 — User preferences (settings actually working)
// ---------------------------------------------------------------------------

/** How the user wants the app themed (Phase 14). SYSTEM follows the OS. */
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

/**
 * A single persisted preferences row per user (Phase 14). Looked up and updated
 * ONLY via the authenticated session user id — never a browser-supplied userId.
 * `theme` drives a real class-based dark mode; `language` is stored for future
 * i18n; the boolean flags are per-user notification toggles layered on top of
 * the Phase 13 channel preferences.
 */
model UserPreferences {
  id        String           @id @default(cuid())
  userId    String           @unique
  theme     ThemePreference  @default(SYSTEM)
  language  String           @default("en")
  weeklyDigest Boolean       @default(false)
  reportUpdates Boolean       @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 10 — Community votes & civic karma (auditable event ledger)
// ---------------------------------------------------------------------------

/**
 * A single typed community vote on an Issue. One (user, issue, type) is unique,
 * so neither a double-click nor a worker retry can produce a duplicate vote.
 * Votes are signals, not authority: the intelligence engine and state machine
 * remain authoritative.
 */
model Vote {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId, type])
  @@index([issueId])
  @@index([userId])
}

/**
 * An auditable karma event. Points are derived ONLY from trusted system events
 * via applyKarmaEvent(); clients can never set User.karmaScore directly.
 * `dedupeKey` is unique so a retried worker can never award points twice.
 */
model KarmaEvent {
  id        String         @id @default(cuid())
  userId    String
  type      KarmaEventType
  points    Int
  issueId   String?
  dedupeKey String?        @unique // e.g. "REPORT_VERIFIED:issue=cc:id" — idempotency guard
  metadata  Json?
  createdAt DateTime       @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([issueId])
  @@index([type])
}

